# Public site URL (optional). Defaults to thrundesigns-com.vercel.app /
# VERCEL_PROJECT_PRODUCTION_URL on Vercel.
NEXT_PUBLIC_SITE_URL=https://thrundesigns-com.vercel.app

# Public Sanity config (safe to commit). Defaults also exist in src/sanity/env.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=fbuy6kak
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_STUDIO_URL=https://thrundesign.sanity.studio

# Server-only tokens from https://www.sanity.io/manage/project/fbuy6kak/api
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_VIEWER_TOKEN=
SANITY_PREVIEW_SECRET=

# Vercel Blob — public media store (site assets):
#   vercel blob create-store thrundesign-media --access public --yes
BLOB_READ_WRITE_TOKEN=
# Private quote attachments (required for quote file uploads):
#   vercel blob create-store thrundesign-quote-private --access private --yes
# Connect with prefix → QUOTE_READ_WRITE_TOKEN (do not reuse public media token)
QUOTE_READ_WRITE_TOKEN=

# Quote form security (P0)
# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC secret for signed form tokens (min 16 chars). Required in production.
QUOTE_FORM_SECRET=
# Upstash Redis — https://console.upstash.com (rate limits + duplicate checks)
# Or install via: vercel integration add upstash
# Marketplace installs may provide KV_REST_API_URL / KV_REST_API_TOKEN instead;
# the quote rate-limiter accepts either pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Quote notify-after-store (P2) — Resend
# Marketplace: vercel integration add resend/resend-email --name thrundesigns-quote-mail
# Or paste an API key from https://resend.com/api-keys
RESEND_API_KEY=
# Fixed inbox (server-side only). Reply-To is the submitter's validated email.
QUOTE_NOTIFY_TO=
# Verified sender. Resend test default works until a domain is verified:
#   Thrun Design Co <onboarding@resend.dev>
QUOTE_NOTIFY_FROM=
# Operator secret for private attachment unlock page + email signed links
# (min 16 chars). Falls back to QUOTE_FORM_SECRET when unset.
# Studio only needs SANITY_STUDIO_SITE_URL (never put this secret in Studio).
QUOTE_ATTACHMENT_SECRET=
