{
  "name": "@thrun-design/counterspace",
  "version": "0.1.0",
  "private": true,
  "description": "Counterspace Field Laboratory — speculative geometry sandbox with signed emitters and four vector-field operators.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./react-preview": {
      "types": "./src/react-preview.tsx",
      "default": "./src/react-preview.tsx"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    }
  },
  "files": [
    "src",
    "PRODUCT.md",
    "DESIGN.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.185.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.4.3"
  }
}
