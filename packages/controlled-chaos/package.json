{
  "name": "@thrun-design/controlled-chaos",
  "version": "0.12.3",
  "private": true,
  "description": "Controlled Chaos Poster Lab — interactive Three.js poster generator for the Thrundesign portfolio.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./react-preview": {
      "types": "./src/react-preview.tsx",
      "default": "./src/react-preview.tsx"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./react-replay": {
      "types": "./src/react-replay.tsx",
      "default": "./src/react-replay.tsx"
    },
    "./persistence": {
      "types": "./src/persistence/hardenCreation.ts",
      "default": "./src/persistence/hardenCreation.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "@react-three/rapier": "^2.0.0",
    "postprocessing": "^6.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.185.0",
    "postprocessing": "^6.39.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "typescript": "^5.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
